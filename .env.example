# Copy to .env and change the passwords.
DB_PASSWORD=change-me
UI_USER=admin
UI_PASSWORD=change-me
# Port of the web UI on the host (bound to 127.0.0.1 only)
WEBUI_PORT=8230
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=1h
MODEL_ID=mistralai/Timestral-28M
TORCH_NUM_THREADS=4
# Extra host IP to expose the UI on (e.g. your Tailscale IP). Leave unset for localhost only.
# WEBUI_BIND_EXTRA=100.x.y.z
